# Chiave API Gemini (AI Studio → Get API key).
# In Google AI Studio il secret viene iniettato automaticamente come GEMINI_API_KEY.
GEMINI_API_KEY=

# Alternativa letta di default da AI SDK (fallback).
# GOOGLE_GENERATIVE_AI_API_KEY=

# Modello Gemini da usare (default: gemini-3.8-flash).
GEMINI_MODEL=gemini-3.8-flash

# Porta del server (default: 3000).
PORT=3000
