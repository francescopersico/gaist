{
  "name": "gaist-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chat a pagina singola con Google Gemini tramite AI SDK, pronta per Google AI Studio.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:watch": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.114",
    "@ai-sdk/react": "^4.0.170",
    "ai": "^7.0.166",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^6.3.0",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
